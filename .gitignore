# ============================================================
# DATA — large, re-downloadable from NYC Open Data. See data/README.md.
# ============================================================
data/raw/
data/processed/

# ============================================================
# REPORTS — keep only article.html + the two reference docs.
# Everything else in reports/ is auto-generated or scratch.
# ============================================================
reports/profile_report.txt
reports/deepdive_sewage.md
reports/insight_plan.md
reports/sweep.md
reports/sweep.json
reports/figures/
reports/_*

# ============================================================
# SRC — keep only the production pipeline:
#   download_data.py -> build_inspections.py -> build_article.py
# Underscore-prefixed scripts are throwaway probes.
# One-off analytical scripts are not part of the build.
# ============================================================
src/_*.py
src/deepdive_sewage.py
src/sweep_insights.py
src/profile_data.py

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Notebook outputs are KEPT — outputs are baked in so the notebook renders
# on GitHub without anyone needing to re-execute it.

